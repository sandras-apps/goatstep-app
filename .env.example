# Copy this file to .env.local and fill in the two values from
# Supabase → Project Settings → API Keys (see README.md).
# .env.local is ignored by git, but these two values are public anyway:
# never put the "secret" / "service_role" key here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
